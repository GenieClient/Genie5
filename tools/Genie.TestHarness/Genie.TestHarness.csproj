<Project Sdk="Microsoft.NET.Sdk">

  <!-- The console test harness (20 modes: DR / WIZ / LICH / REPLAY / DROP /
       COMPARE / …). It used to live INSIDE Genie.Core as top-level statements,
       which made dev-only code Core's entry point: Core had to be an Exe, that
       Exe had to be SelfContained so the App could reference it, the harness
       shipped inside Genie.Core.dll to every user on four platforms, and
       NETSDK1151 blocked the test project from using a plain ProjectReference
       (hence ~45 lines of HintPath/CoreOutDir scaffolding and a ModuleInitializer
       assembly resolver). Moving it here reverts Core to the pure library the
       architecture always claimed (#122 finding 6).

       Run it exactly as before: dotnet run from this directory, with the mode
       and its arguments after the usual argument separator (REPLAY, DR, WIZ,
       LICH and the rest are documented at the top of TestHarness.cs). -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>Genie.TestHarness</AssemblyName>
    <RootNamespace>Genie.TestHarness</RootNamespace>
    <!-- Dev tooling: never packed, never part of a release lane. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Genie.Core/Genie.Core.csproj" />
  </ItemGroup>

</Project>
