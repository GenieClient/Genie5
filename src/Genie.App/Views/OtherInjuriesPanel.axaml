<!-- Bespoke view for injuries-<charnum> (#156 Phase 2, public #345): another
     character's wounds, drawn with the Injuries panel's sprites in the same
     4-column grid. A part DR attached a transfer cmd to is a button; the click
     goes back through the host dialog VM, so it is resolved and escaped like
     every other dialog command. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Genie.App.ViewModels"
             x:Class="Genie.App.Views.OtherInjuriesPanel"
             x:DataType="vm:OtherInjuriesViewModel">

  <UserControl.Styles>
    <!-- A body part is a flat button: the sprite is the affordance, and a
         non-transferable part must not look pressable. -->
    <Style Selector="Button.part">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush"     Value="Transparent"/>
      <Setter Property="Padding"         Value="2,3"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.part:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.part:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
    </Style>
    <Style Selector="Button.extra">
      <Setter Property="MinWidth" Value="64"/>
      <Setter Property="Padding"  Value="10,3"/>
    </Style>
  </UserControl.Styles>

  <!-- The dialog's own non-sprite controls (public #374). Only the kinds DR
       sends in this window are templated; anything else shows as nothing
       rather than as a type name. -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:DialogProgressViewModel">
      <Grid MinWidth="160">
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Value}" Height="16"/>
        <TextBlock Text="{Binding Caption}" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:DialogButtonViewModel">
      <Button Classes="extra" Content="{Binding Caption}" IsEnabled="{Binding IsEnabled}"
              Tag="{Binding Id}" Click="OnExtraClicked"/>
    </DataTemplate>
    <DataTemplate DataType="vm:DialogLinkViewModel">
      <Button Content="{Binding Caption}" IsEnabled="{Binding IsEnabled}"
              ToolTip.Tip="{Binding Tooltip}" Tag="{Binding Id}" Click="OnExtraClicked"/>
    </DataTemplate>
    <DataTemplate DataType="vm:DialogLabelViewModel">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate DataType="vm:DialogControlViewModel">
      <Panel/>
    </DataTemplate>
  </UserControl.DataTemplates>

  <ScrollViewer>
    <StackPanel Spacing="6" Margin="8">
      <TextBlock Text="{Binding Subject}" FontWeight="SemiBold"/>
      <TextBlock FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                 IsVisible="{Binding AnyTransfer}"
                 Text="Click an injured part to transfer it."/>

      <ItemsControl ItemsSource="{Binding Extras}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ContentControl Content="{Binding}" Margin="0,0,6,4" VerticalAlignment="Center"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Parts}" MaxWidth="260" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OtherInjuriesViewModel+Part">
            <Button Classes="part"
                    IsEnabled="{Binding CanTransfer}"
                    ToolTip.Tip="{Binding Tip}"
                    ToolTip.ShowOnDisabled="True"
                    Tag="{Binding}"
                    Click="OnPartClicked">
              <StackPanel Spacing="2">
                <Image Source="{Binding Cell.Sprite}" Height="52" Stretch="Uniform"
                       Opacity="{Binding Cell.SpriteOpacity}"/>
                <TextBlock Text="{Binding Cell.Label}" FontSize="9" HorizontalAlignment="Center"
                           Foreground="{Binding Cell.Foreground}"/>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="No injuries." Opacity="0.7" IsVisible="{Binding IsEmpty}"/>
      <ItemsControl ItemsSource="{Binding Injured}" IsVisible="{Binding !IsEmpty}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
