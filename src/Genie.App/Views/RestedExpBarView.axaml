<!-- Rested-EXP gauge for the right end of the hands strip. Declared once here and
     hosted in both the top and bottom strip, like StatusBarView. The fill is
     SPENDABLE time (min of banked / this cycle's allowance) over the cap, coloured
     green / yellow / red by Vitals.ApplyRestedExp. Hidden until the first
     `exp rexp` line arrives or when the user turns it off. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Genie.App.ViewModels"
             x:Class="Genie.App.Views.RestedExpBarView"
             x:DataType="vm:MainWindowViewModel">
  <!-- Sizing (#405): stretches to the strip's height like the S / L / R
       boxes; the ProgressBar's MinWidth/MinHeight override Fluent's 200 px
       minimum so the gauge stays inside its frame. -->
  <Border MinWidth="100" Width="110"
          BorderBrush="#444" BorderThickness="1" CornerRadius="3" ClipToBounds="True"
          ToolTip.Tip="{Binding Vitals.RestedTip}">
    <Border.IsVisible>
      <MultiBinding Converter="{x:Static BoolConverters.And}">
        <Binding Path="Vitals.HasRestedExp"/>
        <Binding Path="Display.ShowRestedExpBar"/>
      </MultiBinding>
    </Border.IsVisible>
    <Grid>
      <ProgressBar Value="{Binding Vitals.RestedFill}" Maximum="100"
                   AutomationProperties.Name="Rested experience, spendable time"
                   Foreground="{Binding Vitals.RestedBarBrush}"
                   Background="{Binding Vitals.RestedTrackBrush}"
                   MinWidth="0" MinHeight="0"
                   VerticalAlignment="Stretch" CornerRadius="2"/>
      <TextBlock Text="{Binding Vitals.RestedLabel}"
                 AutomationProperties.LiveSetting="Off"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="10" Foreground="#fff" FontWeight="SemiBold"/>
    </Grid>
  </Border>
</UserControl>
