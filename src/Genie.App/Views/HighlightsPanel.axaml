<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Genie.App.Views"
             x:Class="Genie.App.Views.HighlightsPanel">

  <!-- Presets used to be a third sub-tab here (the Genie 4 layout). They
       moved to their own top-level Configuration tab (public #304): presets
       now drive panel colours too (the Mobs window's creatures colour), and
       people looking for them never thought to open Highlights. -->
  <TabControl>

    <TabItem Header="Strings">
      <views:HighlightStringsPanel Name="StringsPanelCtrl"/>
    </TabItem>

    <TabItem Header="Names">
      <views:NamesPanel Name="NamesPanelCtrl"/>
    </TabItem>

  </TabControl>
</UserControl>
