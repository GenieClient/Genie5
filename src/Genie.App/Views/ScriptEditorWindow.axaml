<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="Genie.App.Views.ScriptEditorWindow"
        Title="Script Editor"
        Width="820" Height="620"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBg}">

  <!-- The built-in script editor (public #243): one non-modal window per file.
       Everything that decides behaviour (save, dirty, disk changes) lives in
       the code-behind; this is only the chrome around the TextEditor. -->
  <DockPanel>

    <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource Theme.ToolbarBg}"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="0,0,0,1" Padding="4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
          <Button x:Name="SaveButton" Content="Save" FontSize="11" Padding="8,2"
                  Click="OnSaveClick"
                  ToolTip.Tip="Save the script (Ctrl+S)"/>
          <Button Content="Find" FontSize="11" Padding="8,2"
                  Click="OnFindClick"
                  ToolTip.Tip="Find and replace in this script (Ctrl+F)"/>
          <Button Content="Reload" FontSize="11" Padding="8,2"
                  Click="OnReloadClick"
                  ToolTip.Tip="Discard unsaved edits and read the file from disk again"/>
        </StackPanel>
        <TextBlock x:Name="PathText" Margin="10,0,4,0" FontSize="11"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Theme.TextSecondary}"/>
      </DockPanel>
    </Border>

    <!-- ── Changed-on-disk banner ─────────────────────────────────────── -->
    <Border x:Name="ChangedBanner" DockPanel.Dock="Top" IsVisible="False"
            Background="{DynamicResource Theme.WarningBg}"
            BorderBrush="{DynamicResource Theme.Warning}"
            BorderThickness="0,0,0,1" Padding="8,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Button x:Name="BannerReloadButton" Content="Reload" FontSize="11" Padding="8,2"
                  Click="OnBannerReloadClick"
                  ToolTip.Tip="Replace the text here with the version on disk"/>
          <Button Content="Keep mine" FontSize="11" Padding="8,2"
                  Click="OnBannerKeepClick"
                  ToolTip.Tip="Keep editing this version; the next Save overwrites the file on disk"/>
        </StackPanel>
        <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource Theme.TextPrimary}"/>
      </DockPanel>
    </Border>

    <!-- ── Status strip ───────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource Theme.StripBg}"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="0,1,0,0" Padding="8,2">
      <TextBlock x:Name="StatusText" FontSize="11"
                 Foreground="{DynamicResource Theme.TextSecondary}"/>
    </Border>

    <ae:TextEditor x:Name="Editor"
                   ShowLineNumbers="True"
                   WordWrap="False"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                   FontSize="13"
                   Padding="4,2,0,0"
                   Background="{DynamicResource Theme.PanelBg}"
                   Foreground="{DynamicResource Theme.TextPrimary}"
                   LineNumbersForeground="{DynamicResource Theme.TextMuted}"/>
  </DockPanel>
</Window>
