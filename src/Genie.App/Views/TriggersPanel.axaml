<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Genie.App.Views.TriggersPanel">

  <Grid RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="4,4,4,0">
      <Button Content="Add New" Click="OnAdd"/>
      <Button Content="Delete"  Click="OnDelete"/>
      <Button Content="Toggle"  Click="OnToggle"/>
      <Button Content="Import…" Click="OnImport"/>
      <TextBox Name="FilterBox" Width="220" Margin="12,0,0,0"
               VerticalAlignment="Center" Watermark="Find… (pattern, action or class)"
               TextChanged="OnFilterChanged"/>
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="4">
      <DataGrid Name="ItemsList"
                Grid.Row="0"
                Margin="0,0,0,4"
                IsReadOnly="True"
                SelectionMode="Single"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                x:CompileBindings="False"
                SelectionChanged="OnSelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="On"      Binding="{Binding EnabledGlyph}" Width="40"/>
          <DataGridTextColumn Header="Scope"   Binding="{Binding Scope}"        Width="Auto"/>
          <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}"      Width="*"/>
          <DataGridTextColumn Header="Action"  Binding="{Binding Action}"       Width="*"/>
          <DataGridTextColumn Header="Class"   Binding="{Binding ClassName}"    Width="Auto"/>
        </DataGrid.Columns>
      </DataGrid>

      <Grid Grid.Row="1"
            ColumnDefinitions="Auto,*,Auto,*"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            Margin="0,4,0,0">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern:" VerticalAlignment="Center" Margin="0,0,8,4"/>
        <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                   Name="PatternBox" Margin="0,0,0,4"
                   FontFamily="Consolas,Courier New,monospace"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Action:" VerticalAlignment="Center" Margin="0,0,8,4"/>
        <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                   Name="ActionBox" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Class:" VerticalAlignment="Center" Margin="0,0,8,4"/>
        <TextBox   Grid.Row="2" Grid.Column="1" Name="ClassBox" Margin="0,0,8,4"/>

        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                    Orientation="Horizontal" Spacing="16" Margin="0,2,0,4">
          <CheckBox Name="CaseSensitiveCheck" Content="Case sensitive"/>
          <CheckBox Name="EnabledCheck"       Content="Enabled" IsChecked="True"/>
          <StackPanel Name="ScopeGroup" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Scope:" VerticalAlignment="Center"/>
            <ComboBox Name="ScopeBox" MinWidth="130" VerticalAlignment="Center"
                      ToolTip.Tip="This character = saved in this profile's config. All characters = saved in the shared global config every character loads."/>
          </StackPanel>
          <CheckBox Name="EvalCheck"          Content="Eval action"
                    ToolTip.Tip="Evaluate {…} expression blocks in the action as script expressions before it runs (math / functions / variables)."/>
          <CheckBox Name="MatchAllCheck"      Content="Match all"
                    ToolTip.Tip="Fire the action once per match on the line (each with its own $1..$n) instead of once for the first match."/>
          <Button   Content="Save"  Click="OnSave"/>
          <Button   Content="Clear" Click="OnClear"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                   Name="StatusText" Margin="0,6,0,0"
                   Foreground="Gray" FontStyle="Italic"/>
      </Grid>
    </Grid>

  </Grid>
</UserControl>
