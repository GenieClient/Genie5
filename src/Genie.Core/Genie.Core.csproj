<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Genie.Core</AssemblyName>
    <RootNamespace>Genie.Core</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>

    <!-- A plain library: no OutputType, no SelfContained. Both used to be
         required because TestHarness.cs lived here as top-level statements and
         made Core an Exe (NETSDK1150 then forced SelfContained so the App's
         self-contained publish could reference it). The harness now lives in
         tools/Genie.TestHarness (#122 finding 6), so Core ships no dev-only
         code and the test project can use a plain ProjectReference again. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The chunker (GameConnection.EmitChunks) is the live path's line
         splitter and has its own regression tests; it stays internal so it
         isn't part of Core's public surface. -->
    <InternalsVisibleTo Include="Genie.Core.Tests" />
    <!-- GenieCore.PublishGameEventForTests test hook (see AssemblyInfo.cs). -->
    <InternalsVisibleTo Include="Genie.App.Tests" />
    <!-- The console harness JSINTEROP mode drives JsLibraryContext, which stays
         internal for the same reason the chunker does. Dev tooling only; the
         harness is never part of a release lane. -->
    <InternalsVisibleTo Include="Genie.TestHarness" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reactive event streams (no WinForms dependency) -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
    <!-- Anthropic .NET SDK for AI pipe -->
    <PackageReference Include="Anthropic.SDK" Version="4.0.0" />
    <!-- Pure-C# JavaScript engine for .js array scripts (cross-platform, no
         native binaries — fits Genie 5's self-contained packaging). -->
    <PackageReference Include="Jint" Version="4.16.1" />
    <!-- Structured logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin API contract — host implements IPluginHost, ships the builtin
         Experience plugin against IGeniePlugin. External plugin DLLs reference
         this same assembly (not all of Core). -->
    <ProjectReference Include="..\Genie.Plugins.Abstractions\Genie.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Baseline ZoneConnections seed extracted on first launch when
         the user's MapsDirectory has no ZoneConnections.xml yet.
         See ZoneConnectionsRepository.Load() for the extraction path. -->
    <EmbeddedResource Include="Mapper\Resources\ZoneConnections.baseline.xml" />

    <!-- Circle Calculator data: guild requirement tables + custom sort groups.
         Shipped embedded as defaults; a user copy in the active config dir
         overrides. See CircleData.ReadData(). -->
    <EmbeddedResource Include="Extensions\Builtin\CircleCalc\Resources\CircleReqs.xml" />
    <EmbeddedResource Include="Extensions\Builtin\CircleCalc\Resources\SortGroups.xml" />
  </ItemGroup>

</Project>
